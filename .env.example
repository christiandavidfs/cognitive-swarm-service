# Copy to .env and fill. Nothing secret is baked into config/ or scripts/.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TOKEN=
# Opt-in ONLY: with =1 the connector may spawn `databricks auth token` / profiles
# CLI subprocess as fallback. Default (unset/0) = never spawn a subprocess.
DATABRICKS_ALLOW_CLI_TOKEN=0
DATABRICKS_CATALOG=testing
DATABRICKS_SCHEMA=testing_schema
DATABRICKS_KNOWLEDGE_TABLE=testing.testing_schema.swarm_knowledge
DATABRICKS_PROCEDURES_TABLE=testing.testing_schema.swarm_procedures

# Optional deterministic backends, tried in order (comma-separated).
# cognitive_swarm needs its package installed; empty/unknown = skipped.
BACKENDS=cognitive_swarm
# Local corpus for the local_docs connector (default: ./retrieval_corpus)
LOCAL_DOCS_DIR=./retrieval_corpus

SERVICE_API_KEY=
# Judge backends: JEV_VIA=typesafe (TYPESAFE_API_KEY) or vercel (AI_GATEWAY_API_KEY).
# TYPESAFE_API_KEY=
# AI_GATEWAY_API_KEY=
# JEV_VIA=vercel
# LAYA — open-weights local decision model sidecar (scripts/laya_server.py).
# LAYA_BASE_URL=http://127.0.0.1:8021
# LAYA_MODEL=convaiinnovations/laya
# LAYA_TEMPERATURE=1.0          # set from temperature-fitting (Gate B), never by hand
# LAYA_UNKNOWN_THRESHOLD=0.15   # top-prob below this routes unknown
# JUDGE_ADJUDICATE=1            # enable Juicio 3 dual-judge consensus (default off)
# LAYA_SECONDARY=jev
# LAYA_ARBITER=jev
# JEV_MODEL=typesafe-ai/jev
# JUDGE=heuristic  # flip to jev to route Juicio 1 through the judge (fallback included)
MEMORY_PATH=./data/verified_memory.json
MEMORY_SIMILARITY_THRESHOLD=0.85
HOST=0.0.0.0
PORT=8000
